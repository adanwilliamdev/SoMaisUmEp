# TMDb — use UMA das duas (o token de leitura v4 é o recomendado)
TMDB_API_KEY=cole_sua_chave_v3_aqui
# TMDB_READ_TOKEN=cole_o_token_de_leitura_v4_aqui

# Supabase (OPCIONAL): sem estas variáveis o app consulta o TMDb direto, sem cache persistente
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# Opcional
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CACHE_DIAS=7
