# Texto longo e aleatório para assinar a sessão. Gere com: openssl rand -hex 32
# (trocar este valor encerra a sessão de todo mundo)
SESSION_SECRET=

# Neon: connection string (Neon Console > Connect). Use a versão "pooled".
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require

# TMDb: use UM dos dois (o token de leitura v4 é o recomendado)
TMDB_READ_TOKEN=
# TMDB_API_KEY=

# (opcional) Vercel Blob: guarda as capas que você envia. Na Vercel: Storage > Create > Blob
# (a variável é criada sozinha ao conectar o Blob ao projeto). Sem ela, as capas ficam no banco.
BLOB_READ_WRITE_TOKEN=

# Faxina diária (api/cron.js): texto aleatório longo. A Vercel envia como "Authorization: Bearer ..." ao chamar o cron.
CRON_SECRET=

# (opcional) Recuperação de senha por e-mail, via Resend (resend.com). Sem estas três, "Esqueci minha senha" fica desligado.
# APP_URL é o endereço público do site, sem barra no final (os links do e-mail usam ele).
# RESEND_API_KEY=
# EMAIL_FROM=SóMaisUmEp <contato@seudominio.com>
# APP_URL=https://seu-site.vercel.app

# (opcional) Depois da primeira conta, os cadastros ficam FECHADOS. Defina "true" para permitir que outras pessoas criem conta.
# CADASTRO_ABERTO=true

# (opcional, só ao atualizar da versão de uma senha) "true" faz a PRIMEIRA conta criada herdar os dados sem dono. Remova depois.
# ADOTAR_DADOS_ANTIGOS=true

# (opcional) Avisos de episódios novos por notificação push. Gere o par de chaves com: npm run vapid
# VAPID_SUBJECT é um contato seu: mailto:voce@exemplo.com (ou o endereço https do site). Sem as três variáveis os avisos ficam desligados.
# O horário do aviso é o do cron (vercel.json, 11:00 UTC = 08:00 em Brasília); FUSO_AVISOS muda o fuso usado para decidir o que é "hoje".
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:voce@exemplo.com
# FUSO_AVISOS=America/Sao_Paulo
