# Senha para entrar no site (use uma frase longa)
APP_PASSWORD=
# Texto longo e aleatório para assinar a sessão. Gere com: openssl rand -hex 32
SESSION_SECRET=

# Neon: connection string (Neon Console > Connect). Use a versão "pooled".
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require

# TMDb: use UM dos dois (o token de leitura v4 é o recomendado)
TMDB_READ_TOKEN=
# TMDB_API_KEY=
